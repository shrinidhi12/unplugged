# Neon Postgres connection string (from neon.tech project dashboard)
DATABASE_URL=

# Resend API key (from resend.com). Leave blank in dev to log emails to the console.
RESEND_API_KEY=

# From address for outgoing email.
# Dev: use Resend's test sender (only delivers to your own verified address):
#   Unplugg Me <onboarding@resend.dev>
# Prod: the verified unplugg.me domain -> Unplugg Me <hello@unplugg.me>
EMAIL_FROM=Unplugg Me <onboarding@resend.dev>

# Public base URL used in links/emails. No trailing slash.
# Prod (set in Netlify env): https://unplugg.me
NEXT_PUBLIC_BASE_URL=http://localhost:3000
